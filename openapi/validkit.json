 "paths": {
  "/iban": {
   "get": {
    "summary": "Validate IBAN",
    "parameters": [
     {
      "name": "value",
      "in": "query",
      "required": true,
      "description": "IBAN",
      "schema": {
       "type": "string"
      },
      "example": "GB82WEST12345698765432"
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   }
  },
