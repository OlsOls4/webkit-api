{
 "openapi": "3.0.0",
 "info": {
  "title": "GeoIP - IP Geolocation, ASN & ISP Lookup",
  "version": "1.0.0"
 },
 "servers": [
  {
   "url": "https://webkit-api-1003933593053.us-central1.run.app/geo"
  }
 ],
 "paths": {
  "/lookup": {
   "get": {
    "summary": "Look up IP",
    "parameters": [
     {
      "name": "ip",
      "in": "query",
      "required": true,
      "description": "IPv4 or IPv6",
      "schema": {
       "type": "string"
      },
      "example": "8.8.8.8"
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   }
  },
  "/me": {
   "get": {
    "summary": "Look up caller's IP",
    "parameters": [],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   }
  },
  "/bulk": {
   "post": {
    "summary": "Bulk lookup (up to 100)",
    "parameters": [],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "example": {
         "ips": [
          "8.8.8.8",
          "1.1.1.1",
          "2a00:1450:4009::1"
         ]
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   }
  }
 }
}