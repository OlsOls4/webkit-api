  "paths": {
    "/holidays": {
      "get": {
        "operationId": "listHolidays",
        "tags": [
          "Holidays"
        ],
        "summary": "List public holidays for a country and year",
        "description": "Returns every public holiday for a country (and optional subdivision) in a year, sorted by date, with weekday names. Substitute 'observed' days are included where the country has them.",
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "required": true,
            "description": "ISO 3166-1 alpha-2 country code (alpha-3 also accepted), case-insensitive. See /countries.",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 3
            },
            "example": "GB"
          },
          {
            "name": "year",
            "in": "query",
            "required": false,
            "description": "Calendar year (1950-2100). Defaults to the current year.",
            "schema": {
              "type": "integer",
              "minimum": 1950,
              "maximum": 2100
            },
            "example": 2026
          },
          {
            "name": "subdiv",
            "in": "query",
            "required": false,
            "description": "Optional subdivision code for regional holidays, e.g. ENG, SCT, WLS, NIR for GB; CA, NY for US; BY for DE. Must belong to `country`. See /countries.",
            "schema": {
              "type": "string"
            },
            "example": "ENG"
          }
        ],
        "responses": {
          "200": {
            "description": "Holidays.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HolidayList"
                },
                "example": {
                  "count": 9,
                  "country": "GB",
                  "holidays": [
                    {
                      "date": "2026-01-01",
                      "name": "New Year's Day",
                      "weekday": "Thursday"
                    },
                    {
                      "date": "2026-04-03",
                      "name": "Good Friday",
                      "weekday": "Friday"
                    },
                    {
                      "date": "2026-04-06",
                      "name": "Easter Monday",
                      "weekday": "Monday"
                    },
                    {
                      "date": "2026-05-04",
                      "name": "May Day",
                      "weekday": "Monday"
                    },
                    {
                      "date": "2026-05-25",
                      "name": "Spring Bank Holiday",
                      "weekday": "Monday"
                    },
                    {
                      "date": "2026-08-31",
                      "name": "Late Summer Bank Holiday",
                      "weekday": "Monday"
                    },
                    {
                      "date": "2026-12-25",
                      "name": "Christmas Day",
                      "weekday": "Friday"
                    },
                    {
                      "date": "2026-12-26",
                      "name": "Boxing Day",
                      "weekday": "Saturday"
                    },
                    {
                      "date": "2026-12-28",
                      "name": "Boxing Day (observed)",
                      "weekday": "Monday"
                    }
                  ],
                  "subdiv": "ENG",
                  "year": 2026
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "description": "Missing or invalid date, country, subdivision or weekend.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Unsupported country. See /countries"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/is-holiday": {
      "get": {
        "operationId": "checkHoliday",
        "tags": [
          "Holidays"
        ],
        "summary": "Check if a date is a holiday or business day",
        "description": "Tells you whether a date is a public holiday (and which), a weekend day, and a business day, for a country and optional subdivision.",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "description": "Date to check, YYYY-MM-DD.",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-12-25"
          },
          {
            "name": "country",
            "in": "query",
            "required": true,
            "description": "ISO 3166-1 alpha-2 country code (alpha-3 also accepted), case-insensitive. See /countries.",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 3
            },
            "example": "GB"
          },
          {
            "name": "subdiv",
            "in": "query",
            "required": false,
            "description": "Optional subdivision code for regional holidays, e.g. ENG, SCT, WLS, NIR for GB; CA, NY for US; BY for DE. Must belong to `country`. See /countries.",
            "schema": {
              "type": "string"
            },
            "example": "ENG"
          },
          {
            "name": "weekend",
            "in": "query",
            "required": false,
            "description": "Comma-separated weekend days (first three letters are used), e.g. `sat,sun` or `fri,sat`.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z]{3,}(,[A-Za-z]{3,})*$",
              "default": "sat,sun"
            },
            "example": "sat,sun"
          }
        ],
        "responses": {
          "200": {
            "description": "Date check.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HolidayCheck"
                },
                "example": {
                  "date": "2026-12-25",
                  "holiday_name": "Christmas Day",
                  "is_business_day": false,
                  "is_holiday": true,
                  "is_weekend": false,
                  "weekday": "Friday"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "description": "Missing or invalid date, country, subdivision or weekend.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Unsupported country. See /countries"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/next-holiday": {
      "get": {
        "operationId": "getNextHolidays",
        "tags": [
          "Holidays"
        ],
        "summary": "Get the next upcoming public holidays",
        "description": "Returns the next public holidays on or after a date (default today), with days away. Looks ahead through the end of the following year.",
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "required": true,
            "description": "ISO 3166-1 alpha-2 country code (alpha-3 also accepted), case-insensitive. See /countries.",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 3
            },
            "example": "US"
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Start date, YYYY-MM-DD. Defaults to today (UTC).",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-10-14"
          },
          {
            "name": "count",
            "in": "query",
            "required": false,
            "description": "How many holidays to return (clamped to 1-20).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 1
            },
            "example": 3
          },
          {
            "name": "subdiv",
            "in": "query",
            "required": false,
            "description": "Optional subdivision code for regional holidays, e.g. ENG, SCT, WLS, NIR for GB; CA, NY for US; BY for DE. Must belong to `country`. See /countries.",
            "schema": {
              "type": "string"
            },
            "example": "CA"
          }
        ],
        "responses": {
          "200": {
            "description": "Upcoming holidays.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NextHolidays"
                },
                "example": {
                  "from_date": "2026-10-14",
                  "holidays": [
                    {
                      "date": "2026-11-11",
                      "days_away": 28,
                      "name": "Veterans Day"
                    },
                    {
                      "date": "2026-11-26",
                      "days_away": 43,
                      "name": "Thanksgiving Day"
                    },
                    {
                      "date": "2026-12-25",
                      "days_away": 72,
                      "name": "Christmas Day"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "description": "Missing or invalid date, country, subdivision or weekend.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Unsupported country. See /countries"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/business-days/add": {
      "get": {
        "operationId": "addBusinessDays",
        "tags": [
          "Business days"
        ],
        "summary": "Add or subtract business days from a date",
        "description": "Moves forward (or back, with negative `days`) by N business days, skipping weekends and the country's public holidays. Returns the resulting date and the holidays skipped. Perfect for delivery estimates, SLA deadlines and payment terms.",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "description": "Start date, YYYY-MM-DD (not counted).",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-12-23"
          },
          {
            "name": "days",
            "in": "query",
            "required": true,
            "description": "Business days to add; negative to subtract (clamped to -3650..3650).",
            "schema": {
              "type": "integer",
              "minimum": -3650,
              "maximum": 3650
            },
            "example": 5
          },
          {
            "name": "country",
            "in": "query",
            "required": true,
            "description": "ISO 3166-1 alpha-2 country code (alpha-3 also accepted), case-insensitive. See /countries.",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 3
            },
            "example": "GB"
          },
          {
            "name": "subdiv",
            "in": "query",
            "required": false,
            "description": "Optional subdivision code for regional holidays, e.g. ENG, SCT, WLS, NIR for GB; CA, NY for US; BY for DE. Must belong to `country`. See /countries.",
            "schema": {
              "type": "string"
            },
            "example": "ENG"
          },
          {
            "name": "weekend",
            "in": "query",
            "required": false,
            "description": "Comma-separated weekend days (first three letters are used), e.g. `sat,sun` or `fri,sat`.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z]{3,}(,[A-Za-z]{3,})*$",
              "default": "sat,sun"
            },
            "example": "sat,sun"
          }
        ],
        "responses": {
          "200": {
            "description": "Resulting date.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusinessDaysAdd"
                },
                "example": {
                  "business_days": 5,
                  "holidays_skipped": [
                    {
                      "date": "2026-12-25",
                      "name": "Christmas Day"
                    },
                    {
                      "date": "2026-12-26",
                      "name": "Boxing Day"
                    },
                    {
                      "date": "2026-12-28",
                      "name": "Boxing Day (observed)"
                    },
                    {
                      "date": "2027-01-01",
                      "name": "New Year's Day"
                    }
                  ],
                  "result": "2027-01-04",
                  "start": "2026-12-23",
                  "weekday": "Monday"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "description": "Missing or invalid date, country, subdivision or weekend.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Unsupported country. See /countries"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/business-days/between": {
      "get": {
        "operationId": "countBusinessDays",
        "tags": [
          "Business days"
        ],
        "summary": "Count business days between two dates",
        "description": "Counts calendar days, business days and weekend days between two dates (both inclusive; order does not matter), and lists the public holidays that fell on working days. Range up to 100 years.",
        "parameters": [
          {
            "name": "start",
            "in": "query",
            "required": true,
            "description": "First date, YYYY-MM-DD (inclusive).",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-12-01"
          },
          {
            "name": "end",
            "in": "query",
            "required": true,
            "description": "Last date, YYYY-MM-DD (inclusive).",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-12-31"
          },
          {
            "name": "country",
            "in": "query",
            "required": true,
            "description": "ISO 3166-1 alpha-2 country code (alpha-3 also accepted), case-insensitive. See /countries.",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 3
            },
            "example": "GB"
          },
          {
            "name": "subdiv",
            "in": "query",
            "required": false,
            "description": "Optional subdivision code for regional holidays, e.g. ENG, SCT, WLS, NIR for GB; CA, NY for US; BY for DE. Must belong to `country`. See /countries.",
            "schema": {
              "type": "string"
            },
            "example": "ENG"
          },
          {
            "name": "weekend",
            "in": "query",
            "required": false,
            "description": "Comma-separated weekend days (first three letters are used), e.g. `sat,sun` or `fri,sat`.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z]{3,}(,[A-Za-z]{3,})*$",
              "default": "sat,sun"
            },
            "example": "sat,sun"
          }
        ],
        "responses": {
          "200": {
            "description": "Counts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusinessDaysBetween"
                },
                "example": {
                  "business_days": 21,
                  "calendar_days": 31,
                  "end": "2026-12-31",
                  "holidays": [
                    {
                      "date": "2026-12-25",
                      "name": "Christmas Day"
                    },
                    {
                      "date": "2026-12-28",
                      "name": "Boxing Day (observed)"
                    }
                  ],
                  "note": "Both start and end dates are included",
                  "start": "2026-12-01",
                  "weekend_days": 8
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "description": "Missing or invalid date, country, subdivision or weekend.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Unsupported country. See /countries"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/timezone": {
      "get": {
        "operationId": "getTimezoneByCoordinates",
        "tags": [
          "Time zones"
        ],
        "summary": "Find the time zone for coordinates",
        "description": "Returns the IANA time zone for a latitude/longitude, with the current local time, UTC offset, abbreviation and DST flag. Ocean points return Etc/GMT zones.",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "description": "Latitude in decimal degrees (-90 to 90).",
            "schema": {
              "type": "number",
              "format": "double",
              "minimum": -90,
              "maximum": 90
            },
            "example": 51.4545
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "description": "Longitude in decimal degrees (-180 to 180).",
            "schema": {
              "type": "number",
              "format": "double",
              "minimum": -180,
              "maximum": 180
            },
            "example": -2.5879
          }
        ],
        "responses": {
          "200": {
            "description": "Time zone.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimezoneResult"
                },
                "example": {
                  "abbreviation": "BST",
                  "is_dst": true,
                  "lat": 51.4545,
                  "lng": -2.5879,
                  "local_time": "2026-10-14T23:43:52+01:00",
                  "timezone": "Europe/London",
                  "utc_offset": "+0100"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "No time zone found for the point.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "No timezone found"
                }
              }
            }
          },
          "422": {
            "description": "lat/lng missing or out of range.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "lat and lng are required numbers"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/convert": {
      "get": {
        "operationId": "convertTime",
        "tags": [
          "Time zones"
        ],
        "summary": "Convert a time between time zones",
        "description": "Converts a date-time from one IANA time zone to another, handling daylight-saving rules for that date. Returns both ISO 8601 timestamps, offsets and the target abbreviation.",
        "parameters": [
          {
            "name": "time",
            "in": "query",
            "required": false,
            "description": "ISO 8601 date-time, e.g. 2026-10-14T09:30. Without an offset it is read as local time in `from`; with an offset, the offset wins. If omitted, the current time in `from` is used.",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "example": "2026-10-14T09:30"
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "Source IANA time zone, e.g. Europe/London.",
            "schema": {
              "type": "string"
            },
            "example": "Europe/London"
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "Target IANA time zone, e.g. America/New_York.",
            "schema": {
              "type": "string"
            },
            "example": "America/New_York"
          }
        ],
        "responses": {
          "200": {
            "description": "Converted time.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimeConversion"
                },
                "example": {
                  "from_offset": "+0100",
                  "from_zone": "Europe/London",
                  "input": "2026-10-14T09:30:00+01:00",
                  "output": "2026-10-14T04:30:00-04:00",
                  "to_abbreviation": "EDT",
                  "to_offset": "-0400",
                  "to_zone": "America/New_York"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "description": "Unknown time zone or bad time.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "from and to must be IANA timezones like Europe/London, America/New_York"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/countries": {
      "get": {
        "operationId": "listSupportedCountries",
        "tags": [
          "Reference"
