            "in": "query",
            "required": true,
            "description": "Text (or POST JSON {\"text\":...})",
            "schema": {
              "type": "string"
            },
            "example": "I love this product but shipping was slow."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
