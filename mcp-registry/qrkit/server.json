{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.OlsOls4/qrkit",
  "title": "QRKit",
  "description": "Generate QR codes (URL, WiFi, vCard) and barcodes as PNG/SVG",
  "repository": {
    "url": "https://github.com/OlsOls4/webkit-api",
    "source": "github"
  },
  "version": "1.1.0",
  "websiteUrl": "https://rapidapi.com/Olly-1VN9JTXKG/api/qrkit-qr-code-barcode-generator",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://qrkit-qr-code-barcode-generator.p.rapidapi.com/mcp",
      "headers": [
        {
          "name": "X-RapidAPI-Key",
          "description": "Your RapidAPI key (subscribe to QRKit on RapidAPI; free plan available)",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "X-RapidAPI-Host",
          "description": "RapidAPI host for this API",
          "isRequired": true,
          "default": "qrkit-qr-code-barcode-generator.p.rapidapi.com",
          "choices": [
            "qrkit-qr-code-barcode-generator.p.rapidapi.com"
          ]
        }
      ]
    }
  ]
}